# 复制为 .env.rag，真实凭据不得提交。管理/只读密钥需不同且至少32字符。
STUDYLENS_ADMIN_KEY=
STUDYLENS_READER_KEY=
STUDYLENS_WORKSPACE=default
STUDYLENS_DATA_DIR=/app/var/knowledge
STUDYLENS_REQUESTS_PER_MINUTE=30

# 容器网络内的Milvus；首次初始化时设置根密码，服务token应为 root:同一密码。
MILVUS_URI=http://milvus:19530
MILVUS_ROOT_PASSWORD=
MILVUS_TOKEN=
MILVUS_COLLECTION=studylens_chunks
MINIO_ROOT_USER=studylens
MINIO_ROOT_PASSWORD=

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# 单次完整导入共享的Embedding批次/时间预算，超限请拆分资料。
STUDYLENS_EMBEDDING_MAX_BATCHES=16
STUDYLENS_EMBEDDING_MAX_SECONDS=90
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MIN_SCORE=0.25
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 可选公网HTTPS反向代理的两个域名；需要已经指向服务器。
STUDYLENS_DOMAIN=
STUDYLENS_API_DOMAIN=
# 额外接口只能由部署者审核后添加，用逗号分隔完整HTTPS基址。
STUDYLENS_ALLOWED_MODEL_BASE_URLS=
